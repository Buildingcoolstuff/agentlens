{
  "name": "agentlens-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "The Open-Source Agentic Web & GEO Engine — Audit in the Browser, Compile in the Build, Orient at the Edge.",
  "author": "AgentLens Maintainers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Buildingcoolstuff/agentlens.git"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,html,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "prettier": "^3.5.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
